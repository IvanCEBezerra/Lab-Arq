DEPTH = 256;            -- The size of memory in words
WIDTH = 32;             -- The size of data in bits
ADDRESS_RADIX = HEX;    -- The radix for address values
DATA_RADIX = HEX;       -- The radix for data values
CONTENT                 -- Start of (address: data pairs)
BEGIN

000 : FFFFF0B7;  -- lui x1,-1
001 : FFF08093;  -- addi x1,x1,-1
002 : 00102023;  -- sw x1,0(x0)
003 : 00000103;  -- lb x2,0(x0)
004 : 00104183;  -- lbu x3,1(x0)
005 : 00201203;  -- lh x4,2(x0)
006 : 00205283;  -- lhu x5,2(x0)
007 : 08000313;  -- addi x6,x0,128
008 : 00600023;  -- sb x6,0(x0)
009 : 00601123;  -- sh x6,2(x0)
00A : 00002383;  -- lw x7,0(x0)
00B : 00002403;  -- lw x8,0(x0)
00C : 007404B3;  -- add x9,x8,x7
00D : 00902223;  -- sw x9,4(x0)
00E : 00402503;  -- lw x10,4(x0)
00F : 00700583;  -- lb x11,7(x0)
010 : 00601323;  -- sh x6,6(x0)
011 : 00605603;  -- lhu x12,6(x0)
012 : 00000063;  -- beq x0,x0,0
[013..0FF] : 00000013;  -- nop
END;
